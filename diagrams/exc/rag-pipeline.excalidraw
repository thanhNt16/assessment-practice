   "link": null,
   "locked": false,
   "seed": 1113,
   "version": 1,
   "versionNonce": 1113,
   "id": "t-1114",
   "type": "text",
   "text": "\u26a0 Exact NN is O(N\u00d7D) \u2014 40M comparisons per query; ANN (HNSW, LSH, clustering) is mandatory past millions of items.",
   "originalText": "\u26a0 Exact NN is O(N\u00d7D) \u2014 40M comparisons per query; ANN (HNSW, LSH, clustering) is mandatory past millions of items.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "strokeColor": "#dc2626",
   "backgroundColor": "transparent",
   "lineHeight": 1.25
  },
  {
   "x": 60,
   "y": 636,
   "width": 1095,
   "height": 18,
   "angle": 0,
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "fillStyle": "solid",
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "seed": 1114,
   "version": 1,
   "versionNonce": 1114,
   "id": "t-1115",
   "type": "text",
   "text": "\u26a0 Retrieval quality ceiling: a better LLM cannot fix bad chunks \u2014 RAFT (train on golden + distractor docs) only after retrieval is fixed.",
   "originalText": "\u26a0 Retrieval quality ceiling: a better LLM cannot fix bad chunks \u2014 RAFT (train on golden + distractor docs) only after retrieval is fixed.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "strokeColor": "#dc2626",
   "backgroundColor": "transparent",
   "lineHeight": 1.25
  },
  {
   "x": 60,
   "y": 662,
   "width": 1095,
   "height": 18,
   "angle": 0,
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "fillStyle": "solid",
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "seed": 1115,
   "version": 1,
   "versionNonce": 1115,
   "id": "t-1116",
   "type": "text",
   "text": "\u26a0 Finetuning for knowledge injection can\u2019t cite sources and needs constant retraining \u2014 retrieve first; finetune the LLM last.",
   "originalText": "\u26a0 Finetuning for knowledge injection can\u2019t cite sources and needs constant retraining \u2014 retrieve first; finetune the LLM last.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "strokeColor": "#dc2626",
   "backgroundColor": "transparent",
   "lineHeight": 1.25
  },
  {
   "x": 60,
   "y": 688,
   "width": 1095,
   "height": 18,
   "angle": 0,
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
