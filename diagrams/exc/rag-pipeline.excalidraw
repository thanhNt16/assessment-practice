   "version": 1,
   "versionNonce": 1112,
   "id": "t-1113",
   "type": "text",
   "text": "Chunking tradeoff: 500 chars + 200 overlap \u2014\nbig chunks blur the match; small chunks\nfragment meaning.",
   "originalText": "Chunking tradeoff: 500 chars + 200 overlap \u2014\nbig chunks blur the match; small chunks\nfragment meaning.",
   "fontSize": 12.5,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "strokeColor": "#c2410c",
   "backgroundColor": "transparent",
   "lineHeight": 1.25
  },
  {
   "x": 60,
   "y": 610,
   "width": 1095,
   "height": 18,
   "angle": 0,
   "strokeWidth": 1,
   "strokeStyle": "solid",
