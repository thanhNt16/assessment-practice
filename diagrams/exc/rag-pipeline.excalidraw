   "locked": false,
   "seed": 1116,
   "version": 1,
   "versionNonce": 1116,
   "id": "t-1117",
   "type": "text",
   "text": "Eval points: offline Ragas/ARES \u2014 retrieval hit@k + answer faithfulness \u00b7 online: adoption, CTR, cost per user (re-rolls burn GPU money).",
   "originalText": "Eval points: offline Ragas/ARES \u2014 retrieval hit@k + answer faithfulness \u00b7 online: adoption, CTR, cost per user (re-rolls burn GPU money).",
