   "locked": false,
   "seed": 1073,
   "version": 1,
   "versionNonce": 1073,
   "id": "t-1074",
   "type": "text",
   "text": "Only event time is reproducible; a watermark is the engine's promise, not a fact \u2014 late data is a dial, not an error.",
   "originalText": "Only event time is reproducible; a watermark is the engine's promise, not a fact \u2014 late data is a dial, not an error.",
