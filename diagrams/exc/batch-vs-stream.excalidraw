   "id": "t-1071",
   "type": "text",
   "text": "Exactly-once = end-to-end: replayable source +\natomic state + transactional sink (or dedupe)",
   "originalText": "Exactly-once = end-to-end: replayable source +\natomic state + transactional sink (or dedupe)",
   "fontSize": 13,
